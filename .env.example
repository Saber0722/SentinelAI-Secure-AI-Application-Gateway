# Copy to .env and adjust. Every variable is optional; defaults are shown.
# Nothing here is required for the mock-model demo, and no cloud credentials exist.

# Model backend: mock | ollama | openai_compatible (e.g. llama.cpp `llama-server`)
SENTINEL_MODEL_BACKEND=mock
SENTINEL_MODEL_NAME=qwen2.5:1.5b
SENTINEL_MODEL_BASE_URL=http://127.0.0.1:11434
# auto = GPU when available, CPU retry on GPU failure; cpu = force CPU (Ollama num_gpu=0)
SENTINEL_INFERENCE_DEVICE=auto
SENTINEL_MODEL_TIMEOUT_S=60
SENTINEL_MAX_OUTPUT_TOKENS=256
# Prompts are only sent to loopback addresses unless this is explicitly true.
SENTINEL_ALLOW_REMOTE_MODEL=false

# Security
SENTINEL_MAX_INPUT_CHARS=8000
SENTINEL_CLASSIFIER_ENABLED=true
# Enables PUT /api/v1/settings and POST /api/v1/evaluate. Use a long random value; leave unset to disable.
SENTINEL_ADMIN_TOKEN=change-me-to-a-long-random-string
# Store prompts (after PII/secret redaction, truncated) in the audit log. Off by default.
SENTINEL_AUDIT_STORE_REDACTED_PROMPT=false
# Larger spaCy model for better PERSON recall (install it explicitly first)
SENTINEL_SPACY_MODEL=en_core_web_sm

# Storage
# SENTINEL_DB_PATH=var/sentinel.db

# Streamlit UI -> API address
SENTINEL_API_URL=http://127.0.0.1:8000
